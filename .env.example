# Copy to .env. Never commit real values.
SF_ENVIRONMENT=dev
SF_LOG_JSON=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in staging/production; dev generates an ephemeral one if unset.
SF_JWT_SECRET=
SF_DATABASE_URL=postgresql+asyncpg://solutionforge:solutionforge@localhost:5432/solutionforge
POSTGRES_PASSWORD=solutionforge
# Connector credential encryption (comma-separated Fernet keys; required in prod).
SF_CREDENTIALS_KEYS=
# LLM: the mock provider works without keys. Set a key to enable anthropic:* models.
SF_LLM_ENABLE_MOCK=true
SF_ANTHROPIC_API_KEY=
# Assistant (docs/ASSISTANT.md). Model IDs come from Anthropic's published model list.
# Without a key the assistant offers only fixture:policy-v1 (a rule-based test policy).
SF_ASSISTANT_MODEL=anthropic:claude-haiku-5-5
SF_ASSISTANT_MAX_TURNS=6
SF_ASSISTANT_MAX_TOOL_CALLS=6
SF_ASSISTANT_DEADLINE_SECONDS=60
SF_ASSISTANT_MAX_RETRIES=2
# Per-run spend cap, USD (estimated from list prices).
SF_ASSISTANT_RUN_BUDGET_USD=0.05
# Semantic embeddings (pip install -e ".[semantic]"; first use downloads ~65 MB).
# Measured on the dev questions: bge-small + dense reaches hit rate @3 12/12 vs 11/12 for
# the default lexical + hybrid (evals/retrieval). Off by default: no download needed.
SF_SEMANTIC_EMBEDDER_ENABLED=false
SF_ASSISTANT_RETRIEVAL_STRATEGY=hybrid
SF_EMBEDDING_CACHE_DIR=
# Observability: OTLP/HTTP trace endpoint (unset = tracing off) and the /metrics bearer
# token (required to expose /metrics outside dev/test).
SF_OTEL_EXPORTER_OTLP_ENDPOINT=
SF_METRICS_TOKEN=
