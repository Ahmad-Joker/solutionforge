{
  "uid": "solutionforge-overview",
  "title": "SolutionForge \u2014 overview",
  "tags": [
    "solutionforge"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
